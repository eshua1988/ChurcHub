{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "church-hub-api",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
"d1_databases": [
  {
    "binding": "HUB_DB",
    "database_name": "church-hub",
    "database_id": "c47f7fd2-0535-4dbd-b299-c3e137c5a6d2"
  }
],
"r2_buckets": [
  {
    "binding": "HUB_FILES",
    "bucket_name": "church-hub-files"
}
